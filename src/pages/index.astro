---
// Simple landing for the template. Lists the reports that exist so you can find
// the share links during a demo. In real use you would keep this private or
// replace it; the reports themselves live at /r/<slug>.
const files = import.meta.glob('../data/reports/*.json', { eager: true });
const reports = Object.entries(files).map(([path, mod]) => ({
  slug: path.split('/').pop().replace('.json', ''),
  domain: mod.default.domain,
  title: mod.default.title,
  score: mod.default.score,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reports template</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #16171b;
        color: #f3f4f6;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
      }
      .card {
        max-width: 560px;
        padding: 40px;
        text-align: center;
      }
      h1 { font-size: 30px; letter-spacing: -0.02em; margin: 0 0 8px; }
      h1 span { color: #8ea2f2; }
      p { color: #9aa1ad; margin: 0 0 24px; }
      code { background: #2c2f36; padding: 2px 6px; border-radius: 6px; }
      ul { list-style: none; padding: 0; margin: 0; text-align: left; }
      li a {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 18px;
        margin-bottom: 10px;
        border: 1px solid #2c2f36;
        border-radius: 12px;
        color: #f3f4f6;
        text-decoration: none;
      }
      li a:hover { border-color: #8ea2f2; }
      li a .score { color: #8ea2f2; font-weight: 700; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Reports<span>.</span></h1>
      <p>
        An open-source template for interactive audit reports served at
        <code>/r/&lt;slug&gt;</code>. Drop a JSON in <code>src/data/reports/</code>,
        rebuild, and share the link. No PDFs.
      </p>
      <ul>
        {
          reports.map((r) => (
            <li>
              <a href={`/r/${r.slug}`} target="_blank">
                <span>{r.domain} · {r.title}</span>
                <span class="score">{r.score}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </body>
</html>
